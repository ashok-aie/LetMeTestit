# ==============================================================================
# Let me TEST it....! (TestPilot AI Engine)
# Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jira Cloud Configuration (Required for Jira Integration)
# ------------------------------------------------------------------------------
# Your Atlassian Cloud URL (e.g., https://your-company.atlassian.net)
JIRA_BASE_URL=https://your-company.atlassian.net

# Your Jira Cloud account email address
JIRA_USER_EMAIL=qa-engineer@example.com

# Atlassian API Token (Generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_atlassian_api_token_here

# ------------------------------------------------------------------------------
# 2. Local LLM Runtime (Ollama)
# ------------------------------------------------------------------------------
# Ollama local daemon endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Recommended model for 16GB Mac: qwen2.5:7b
# Lightweight fallback for Intel Mac or low memory: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b

# LLM inference timeout in seconds (default: 60)
OLLAMA_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Environment & Security Guardrails
# ------------------------------------------------------------------------------
# Active environment profile: local | test | staging
APP_ENV=local

# Comma-separated list of approved hostnames the browser is allowed to visit
# Navigation outside these domains is strictly blocked by the Policy Engine
ALLOWED_DOMAINS=localhost,127.0.0.1

# URL of the local demo target application
DEMO_APP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Playwright Browser Automation
# ------------------------------------------------------------------------------
# Run browser in headless mode (true) or visible UI window (false)
BROWSER_HEADLESS=true

# Browser step timeout in milliseconds (default: 10000ms = 10s)
BROWSER_STEP_TIMEOUT_MS=10000

# Browser slow motion delay between actions in milliseconds (0 for normal speed)
BROWSER_SLOW_MO_MS=0

# ------------------------------------------------------------------------------
# 5. Persistence & Evidence Storage
# ------------------------------------------------------------------------------
# SQLite database file path
SQLITE_DB_PATH=testpilot.db

# Root directory for traces, screenshots, and logs
ARTIFACTS_DIR=artifacts

# ------------------------------------------------------------------------------
# 6. Cloud LLM Providers (Optional alternatives to Ollama)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here

# ------------------------------------------------------------------------------
# 7. Langfuse Observability & Telemetry
# ------------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 8. SAP S/4HANA Environment (Optional)
# ------------------------------------------------------------------------------
SAP_FIORI_URL=https://s4srv25.nodomain.com:44325/sap/bc/ui2/flp?sap-client=100&sap-language=EN#Launchpad-openFLPPage?pageId=SAP_CRM_PG_SERVICE_PROCESSING&spaceId=SAP_CRM_SP_SERVICE
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT=100
SAP_LANGUAGE=EN


